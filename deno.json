{
    "compilerOptions": {
        "lib":[
            "deno.ns",
            "ES2021",
            "dom",
            "dom.iterable"
        ]
    },
    "lint": {
        "include": ["www/"],
        "exclude": ["www/dist/"]
    },
    "imports": {
        "esbuild": "https://deno.land/x/esbuild@v0.28.0/mod.js",
        "esbuild_deno_loader/": "https://deno.land/x/esbuild_deno_loader@0.9.0/",
        "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@^2.7.1",
        "react": "npm:react@^19.2.6",
        "react/jsx-runtime": "npm:react@^19.2.6/jsx-runtime",
        "react-dom": "npm:react-dom@^19.2.6",
        "react-dom/client": "npm:react-dom@^19.2.6/client",
        "twind": "npm:twind@^0.16.19"
    },
    "permissions": {
        "default": {
            "read": {
                "allow": ["./deno.json","./www/", "/home/vscode/.cache"]
            },
            "write": {
                "allow": ["/home/vscode/.cache/esbuild/bin","/home/vscode/.cache/esbuild/bin/@esbuild-linux-x64@0.28.0", "/home/vscode/.cache/deno"]  
            },
            "env": {
                "allow": ["DENO_DIR","DENO_REGISTRY_URL","ESBUILD_BINARY_PATH","XDG_CACHE_HOME","HOME","NPM_CONFIG_REGISTRY"]
            },
            "run": {
                "allow": true,
                "deny": []
            },
            "net": {
                "allow": ["registry.npmjs.org:443"],
                "deny": []
            }
        }
    }
}
